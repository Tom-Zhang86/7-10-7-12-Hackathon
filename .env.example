OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Presence-aware A2A handoff
AI_DESK_A2A_AGENT_URL=http://127.0.0.1:9110
AI_DESK_A2A_TIMEOUT_SECONDS=180
AI_DESK_HANDOFF_GRACE_SECONDS=3
AI_DESK_HANDOFF_DB=data/handoffs.sqlite3
AI_DESK_HANDOFF_OUTPUT=data/handoffs

# Optional ESP32 serial override
# AI_DESK_SERIAL_PORT=/dev/cu.usbserial-0001
AI_DESK_SERIAL_BAUD=115200

# AI Desk V2 owner-authorized handoff (Phase 1 config/domain/state-machine/
# classification, plus Phase 2 presence fusion, radar/wearable simulators,
# and the handoff-question lifecycle — see application/owner_handoff/README.md
# for what is implemented vs. deferred). All values below are optional;
# defaults match the Master Spec.
AI_DESK_V2_LEAVE_CONFIRM_SECONDS=10
AI_DESK_V2_INPUT_IDLE_SECONDS=5
AI_DESK_V2_QUESTION_EXPIRY_SECONDS=60
AI_DESK_V2_CODING_MAX_RUNTIME_SECONDS=300
AI_DESK_V2_CODING_MAX_STEPS=20
AI_DESK_V2_DB_PATH=data/owner_handoff.sqlite3
AI_DESK_V2_SESSION_ROOT=data/owner_handoff/sessions
# noop (default, always available) or mock (tests/simulator development only)
AI_DESK_V2_OCR_MODE=noop
# Comma-separated wearable device ids to accept answers from. Empty (the
# default) rejects every real/simulated answer until explicitly configured —
# there is no "accept anything" fallback.
# AI_DESK_V2_WEARABLE_DEVICE_IDS=wearable-001

# The following are NOT environment variables and must never be added here:
# mandatory safety invariants (wearable UNKNOWN never triggers, contradictory
# signals always wait, external actions denied, OCR's fixed invocation order,
# an unanswered/timed-out question always resolving to D, a missing Codex CLI
# always stopping safely, Codex isolation fail-closed, original workspace
# never writable, external publish/push/message/deploy prohibited) are
# centralized as constants in application/owner_handoff/config.py and are
# deliberately not overridable.
